# ----------------------------------------------------
# Step 1: Create Table 'wishes' in Supabase SQL Editor:
# ----------------------------------------------------
# CREATE TABLE wishes (
#   id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
#   name TEXT NOT NULL,
#   message TEXT NOT NULL,
#   attending BOOLEAN DEFAULT true,
#   receipt_url TEXT,
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
# );
#
# -- Enable Row Level Security (RLS)
# ALTER TABLE wishes ENABLE ROW LEVEL SECURITY;
#
# -- Allow anyone to read wishes
# CREATE POLICY "Public read wishes" ON wishes FOR SELECT USING (true);
#
# -- Allow anyone to insert wishes
# CREATE POLICY "Public insert wishes" ON wishes FOR INSERT WITH CHECK (true);
#
# -- Allow anyone / admin to delete wishes
# CREATE POLICY "Admin delete wishes" ON wishes FOR DELETE USING (true);

# ----------------------------------------------------
# Step 2: Create Storage Bucket 'receipts' in Supabase:
# ----------------------------------------------------
# 1. Go to Supabase Dashboard -> Storage -> New Bucket
# 2. Name: receipts
# 3. Public bucket: ENABLED (ON)
# 4. In SQL Editor or Storage Policies, run:
#
# -- Allow public upload to receipts bucket
# CREATE POLICY "Allow Public Upload to receipts"
# ON storage.objects FOR INSERT
# WITH CHECK (bucket_id = 'receipts');
#
# -- Allow public view of receipts
# CREATE POLICY "Allow Public Read receipts"
# ON storage.objects FOR SELECT
# USING (bucket_id = 'receipts');
