# ----------------------------------------------------
# Wedding Wishes Online Cloud Database Setup (Optional)
# ----------------------------------------------------
# If you want wishes to sync across all guest phones in real-time,
# copy this file to `.env` and fill in your Supabase credentials:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ----------------------------------------------------
# Supabase SQL Table Schema (Run in Supabase SQL Editor):
# ----------------------------------------------------
# CREATE TABLE wishes (
#   id TEXT PRIMARY KEY,
#   name TEXT NOT NULL,
#   message TEXT NOT NULL,
#   attending BOOLEAN DEFAULT true,
#   receipt_url TEXT,
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
# );
#
# -- Enable Row Level Security (RLS)
# ALTER TABLE wishes ENABLE ROW LEVEL SECURITY;
#
# -- Allow anyone to read wishes
# CREATE POLICY "Public read wishes" ON wishes FOR SELECT USING (true);
#
# -- Allow guests to insert wishes
# CREATE POLICY "Public insert wishes" ON wishes FOR INSERT WITH CHECK (true);
#
# -- Allow admin to delete wishes
# CREATE POLICY "Admin delete wishes" ON wishes FOR DELETE USING (true);
